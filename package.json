{
  "name": "chaosdot",
  "version": "1.0.0",
  "description": "Autonomous Slashing Resilience Fuzzer & Consensus Verifier for Portaldot",
  "main": "dist/cli/index.js",
  "bin": {
    "chaosdot": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "copy-assets": "node -e \"const fs = require('fs'); fs.mkdirSync('dist/server/public', { recursive: true }); fs.copyFileSync('src/server/public/index.html', 'dist/server/public/index.html');\"",
    "start": "node dist/server/index.js",
    "cli": "ts-node src/cli/index.ts",
    "dev": "ts-node src/server/index.ts",
    "test": "ts-node tests/equivocation.test.ts"
  },
  "keywords": [
    "portaldot",
    "substrate",
    "chaos-engineering",
    "equivocation",
    "slashing",
    "validators",
    "consensus"
  ],
  "author": "Portaldot Infrastructure Team",
  "license": "Apache-2.0",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "ws": "^8.16.0",
    "yaml": "^2.4.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "@types/ws": "^8.5.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
