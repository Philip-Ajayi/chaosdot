{
  "name": "chaosdot",
  "version": "2.0.0",
  "description": "Live Consensus-Aware Slashing Fuzzer & Real-Time Fault Injection Engine for Substrate & Portaldot",
  "main": "dist/cli/index.js",
  "bin": {
    "chaosdot": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "copy-assets": "node -e \"const fs = require('fs'); fs.mkdirSync('dist/server/public', { recursive: true }); fs.copyFileSync('src/server/public/index.html', 'dist/server/public/index.html');\"",
    "start": "node dist/server/index.js",
    "cli": "ts-node src/cli/index.ts",
    "dev": "ts-node src/server/index.ts",
    "test": "ts-node tests/equivocation.test.ts"
  },
  "keywords": [
    "portaldot",
    "substrate",
    "chaos-engineering",
    "equivocation",
    "slashing",
    "validators",
    "consensus"
  ],
  "author": "Portaldot Infrastructure Team",
  "license": "Apache-2.0",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^13.1.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "ws": "^8.18.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.5.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
